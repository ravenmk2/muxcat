{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ravenmk2/muxcat/schema/nacos.schema.json",
  "title": "nacos connector config (nacos.json)",
  "allOf": [
    { "$ref": "connector-common.schema.json#/$defs/connectorDoc" }
  ],
  "properties": {
    "instances": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nacosInstance" }
    },
    "connections": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nacosConnection" }
    }
  },
  "$defs": {
    "nacosInstance": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "enum": ["auto", "2", "3"], "default": "auto" }
      },
      "additionalProperties": false
    },
    "nacosConnection": {
      "type": "object",
      "required": ["instance"],
      "properties": {
        "instance": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "namespace": { "type": "string" },
        "readonly": { "type": "boolean" },
        "timeout": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
