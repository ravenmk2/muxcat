{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ravenmk2/muxcat/schema/sqlite.schema.json",
  "title": "sqlite connector config (sqlite.json)",
  "allOf": [
    { "$ref": "connector-common.schema.json#/$defs/connectorDoc" }
  ],
  "properties": {
    "instances": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sqliteInstance" }
    }
  },
  "$defs": {
    "sqliteInstance": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
