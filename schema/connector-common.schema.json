{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ravenmk2/muxcat/schema/connector-common.schema.json",
  "title": "Common connector config skeleton (Connector -> Instance -> Connection)",
  "$defs": {
    "connection": {
      "type": "object",
      "required": ["instance"],
      "properties": {
        "instance": { "type": "string", "minLength": 1 },
        "readonly": { "type": "boolean" },
        "timeout": { "type": "string" }
      }
    },
    "connectorDoc": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "instances": { "type": "object" },
        "connections": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/connection" }
        },
        "defaultConnection": { "type": "string" }
      }
    }
  }
}
