{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ravenmk2/muxcat/schema/emqx.schema.json",
  "title": "emqx connector config (emqx.json)",
  "allOf": [
    { "$ref": "connector-common.schema.json#/$defs/connectorDoc" }
  ],
  "properties": {
    "instances": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/emqxInstance" }
    },
    "connections": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/emqxConnection" }
    }
  },
  "$defs": {
    "emqxInstance": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "emqxConnection": {
      "type": "object",
      "required": ["instance"],
      "properties": {
        "instance": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "apiSecret": { "type": "string" },
        "readonly": { "type": "boolean" },
        "timeout": { "type": "string" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["username", "password"] },
        { "required": ["apiKey", "apiSecret"] }
      ],
      "dependentRequired": {
        "username": ["password"],
        "password": ["username"],
        "apiKey": ["apiSecret"],
        "apiSecret": ["apiKey"]
      }
    }
  }
}
